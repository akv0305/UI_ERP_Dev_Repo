generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  email              String?   @unique
  displayName        String
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid

  createdBy    User?        @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?        @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  createdUsers User[]       @relation("UserCreatedBy")
  updatedUsers User[]       @relation("UserUpdatedBy")
  roles        UserRole[]
  sessions     Session[]
  auditEvents  AuditEvent[]

  createdUserRoles UserRole[] @relation("UserRoleCreatedBy")

  createdCompanies        Company[]                @relation("CompanyCreatedBy")
  updatedCompanies        Company[]                @relation("CompanyUpdatedBy")
  createdGstRegistrations CompanyGstRegistration[] @relation("GstRegistrationCreatedBy")
  updatedGstRegistrations CompanyGstRegistration[] @relation("GstRegistrationUpdatedBy")
  createdProjects         Project[]                @relation("ProjectCreatedBy")
  updatedProjects         Project[]                @relation("ProjectUpdatedBy")
  createdSites            Site[]                   @relation("SiteCreatedBy")
  updatedSites            Site[]                   @relation("SiteUpdatedBy")
  createdStores           Store[]                  @relation("StoreCreatedBy")
  updatedStores           Store[]                  @relation("StoreUpdatedBy")

  createdUnits          Unit[]         @relation("UnitCreatedBy")
  updatedUnits          Unit[]         @relation("UnitUpdatedBy")
  createdItemCategories ItemCategory[] @relation("ItemCategoryCreatedBy")
  updatedItemCategories ItemCategory[] @relation("ItemCategoryUpdatedBy")
  createdItems          Item[]         @relation("ItemCreatedBy")
  updatedItems          Item[]         @relation("ItemUpdatedBy")
  submittedItems        Item[]         @relation("ItemSubmittedBy")
  decidedItems          Item[]         @relation("ItemDecidedBy")

  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

enum RoleScopeType {
  GLOBAL
  COMPANY
  PROJECT
  SITE
}

/// A role granted to a user at one scope. GLOBAL rows carry no target; COMPANY / PROJECT / SITE rows
/// carry exactly the matching target id (enforced by a CHECK constraint added in the migration).
model UserRole {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  roleId      String        @db.Uuid
  scopeType   RoleScopeType @default(GLOBAL)
  companyId   String?       @db.Uuid
  projectId   String?       @db.Uuid
  siteId      String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  createdById String?       @db.Uuid

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("UserRoleCreatedBy", fields: [createdById], references: [id])

  /// The migration creates this as UNIQUE NULLS NOT DISTINCT so GLOBAL duplicates are rejected too.
  @@unique([userId, roleId, scopeType, companyId, projectId, siteId], map: "user_roles_assignment_key")
  @@index([userId])
  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@map("user_roles")
}

model RolePermission {
  roleId         String @db.Uuid
  permissionCode String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  currentCompanyId String? @db.Uuid
  currentProjectId String? @db.Uuid

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCompany Company? @relation("SessionCurrentCompany", fields: [currentCompanyId], references: [id], onDelete: SetNull)
  currentProject Project? @relation("SessionCurrentProject", fields: [currentProjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  REACTIVATE
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  occurredAt  DateTime    @default(now()) @db.Timestamptz(3)
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String      @db.Uuid
  companyId   String?     @db.Uuid
  before      Json?
  after       Json?
  requestId   String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([actorUserId])
  @@map("audit_events")
}

enum CompanyEntityType {
  COMPANY
  SPV
  JV
}

enum GstRegistrationType {
  REGULAR
  COMPOSITION
  SEZ_UNIT
  CASUAL
  ISD
}

model State {
  id       String  @id @default(uuid()) @db.Uuid
  gstCode  String  @unique @db.Char(2)
  name     String
  isActive Boolean @default(true)

  companies        Company[]
  gstRegistrations CompanyGstRegistration[]
  projects         Project[]
  sites            Site[]

  @@map("states")
}

model Company {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique
  legalName    String
  entityType   CompanyEntityType
  pan          String?
  tan          String?
  cin          String?
  llpin        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  stateId      String?           @db.Uuid
  pinCode      String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  createdById  String            @db.Uuid
  updatedById  String            @db.Uuid

  state            State?                   @relation(fields: [stateId], references: [id])
  createdBy        User                     @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  updatedBy        User                     @relation("CompanyUpdatedBy", fields: [updatedById], references: [id])
  gstRegistrations CompanyGstRegistration[]
  projects         Project[]
  userRoles        UserRole[]
  sessionContexts  Session[]                @relation("SessionCurrentCompany")

  @@map("companies")
}

model CompanyGstRegistration {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @db.Uuid
  stateId          String              @db.Uuid
  gstin            String              @unique
  registrationType GstRegistrationType
  effectiveFrom    DateTime?           @db.Date
  addressLine1     String
  addressLine2     String?
  city             String
  pinCode          String
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  createdById      String              @db.Uuid
  updatedById      String              @db.Uuid

  company         Company   @relation(fields: [companyId], references: [id])
  state           State     @relation(fields: [stateId], references: [id])
  createdBy       User      @relation("GstRegistrationCreatedBy", fields: [createdById], references: [id])
  updatedBy       User      @relation("GstRegistrationUpdatedBy", fields: [updatedById], references: [id])
  billingProjects Project[]

  @@index([companyId])
  @@map("company_gst_registrations")
}

model Project {
  id                       String   @id @default(uuid()) @db.Uuid
  companyId                String   @db.Uuid
  code                     String
  name                     String
  stateId                  String?  @db.Uuid
  billingGstRegistrationId String?  @db.Uuid
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)
  createdById              String   @db.Uuid
  updatedById              String   @db.Uuid

  company    Company                 @relation(fields: [companyId], references: [id])
  state      State?                  @relation(fields: [stateId], references: [id])
  billingGst CompanyGstRegistration? @relation(fields: [billingGstRegistrationId], references: [id])
  createdBy  User                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  updatedBy  User                    @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])
  sites      Site[]
  userRoles  UserRole[]

  sessionContexts Session[] @relation("SessionCurrentProject")

  @@index([companyId])
  @@map("projects")
}

model Site {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  code          String
  name          String
  addressLine1  String?
  addressLine2  String?
  city          String?
  stateId       String?  @db.Uuid
  pinCode       String?
  contactPerson String?
  contactPhone  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  createdById   String   @db.Uuid
  updatedById   String   @db.Uuid

  project   Project    @relation(fields: [projectId], references: [id])
  state     State?     @relation(fields: [stateId], references: [id])
  createdBy User       @relation("SiteCreatedBy", fields: [createdById], references: [id])
  updatedBy User       @relation("SiteUpdatedBy", fields: [updatedById], references: [id])
  stores    Store[]
  userRoles UserRole[]

  @@index([projectId])
  @@map("sites")
}

model Store {
  id          String   @id @default(uuid()) @db.Uuid
  siteId      String   @db.Uuid
  code        String
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String   @db.Uuid
  updatedById String   @db.Uuid

  site      Site @relation(fields: [siteId], references: [id])
  createdBy User @relation("StoreCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("StoreUpdatedBy", fields: [updatedById], references: [id])

  @@index([siteId])
  @@map("stores")
}

enum ItemUse {
  STOCK_AND_ISSUE
  STOCK_ONLY
}

enum ItemStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Unit of measure. decimalPlaces (0-3) limits quantities entered in this unit (CHECK in migration).
model Unit {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  decimalPlaces Int      @default(0) @db.SmallInt
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  createdById   String   @db.Uuid
  updatedById   String   @db.Uuid

  createdBy User   @relation("UnitCreatedBy", fields: [createdById], references: [id])
  updatedBy User   @relation("UnitUpdatedBy", fields: [updatedById], references: [id])
  items     Item[]

  @@map("units")
}

/// Shown to users as "Category (Group)". code IG-0001 is generated by the API from a sequence. becomes /// Shown to users as "Category (Group)". code IG-0001 = last saved number + 1 (no gaps, PD-041).
model ItemCategory {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String   @db.Uuid
  updatedById String   @db.Uuid

  createdBy User   @relation("ItemCategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User   @relation("ItemCategoryUpdatedBy", fields: [updatedById], references: [id])
  items     Item[]

  @@map("item_categories")
}

/// Shared by all companies. code ITM-000001 is generated by the API from a sequence and never changes. becomes /// Shared by all companies. code ITM-000001 = last saved number + 1 (no gaps, PD-041); never changes.
model Item {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique
  description     String
  size            String?
  categoryId      String     @db.Uuid
  unitId          String     @db.Uuid
  itemUse         ItemUse    @default(STOCK_AND_ISSUE)
  hsnCode         String?
  gstRate         Decimal?   @db.Decimal(5, 2)
  remarks         String?
  status          ItemStatus @default(DRAFT)
  submittedAt     DateTime?  @db.Timestamptz(3)
  submittedById   String?    @db.Uuid
  decidedAt       DateTime?  @db.Timestamptz(3)
  decidedById     String?    @db.Uuid
  decisionRemarks String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  createdById     String     @db.Uuid
  updatedById     String     @db.Uuid

  category    ItemCategory @relation(fields: [categoryId], references: [id])
  unit        Unit         @relation(fields: [unitId], references: [id])
  submittedBy User?        @relation("ItemSubmittedBy", fields: [submittedById], references: [id])
  decidedBy   User?        @relation("ItemDecidedBy", fields: [decidedById], references: [id])
  createdBy   User         @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedBy   User         @relation("ItemUpdatedBy", fields: [updatedById], references: [id])

  @@index([categoryId])
  @@index([unitId])
  @@index([status])
  @@map("items")
}
