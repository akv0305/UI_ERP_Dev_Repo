generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  email              String?   @unique
  displayName        String
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid

  createdBy    User?        @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?        @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  createdUsers User[]       @relation("UserCreatedBy")
  updatedUsers User[]       @relation("UserUpdatedBy")
  roles        UserRole[]
  sessions     Session[]
  auditEvents  AuditEvent[]

  createdUserRoles UserRole[] @relation("UserRoleCreatedBy")

  createdCompanies        Company[]                @relation("CompanyCreatedBy")
  updatedCompanies        Company[]                @relation("CompanyUpdatedBy")
  createdGstRegistrations CompanyGstRegistration[] @relation("GstRegistrationCreatedBy")
  updatedGstRegistrations CompanyGstRegistration[] @relation("GstRegistrationUpdatedBy")
  createdProjects         Project[]                @relation("ProjectCreatedBy")
  updatedProjects         Project[]                @relation("ProjectUpdatedBy")
  createdSites            Site[]                   @relation("SiteCreatedBy")
  updatedSites            Site[]                   @relation("SiteUpdatedBy")
  createdStores           Store[]                  @relation("StoreCreatedBy")
  updatedStores           Store[]                  @relation("StoreUpdatedBy")

  createdUnits          Unit[]         @relation("UnitCreatedBy")
  updatedUnits          Unit[]         @relation("UnitUpdatedBy")
  createdItemCategories ItemCategory[] @relation("ItemCategoryCreatedBy")
  updatedItemCategories ItemCategory[] @relation("ItemCategoryUpdatedBy")
  createdItems          Item[]         @relation("ItemCreatedBy")
  updatedItems          Item[]         @relation("ItemUpdatedBy")
  submittedItems        Item[]         @relation("ItemSubmittedBy")
  decidedItems          Item[]         @relation("ItemDecidedBy")

  createdVendors                Vendor[]                @relation("VendorCreatedBy")
  updatedVendors                Vendor[]                @relation("VendorUpdatedBy")
  submittedVendors              Vendor[]                @relation("VendorSubmittedBy")
  decidedVendors                Vendor[]                @relation("VendorDecidedBy")
  createdVendorGstRegistrations VendorGstRegistration[] @relation("VendorGstCreatedBy")
  updatedVendorGstRegistrations VendorGstRegistration[] @relation("VendorGstUpdatedBy")
  createdVendorBankAccounts     VendorBankAccount[]     @relation("VendorBankCreatedBy")
  updatedVendorBankAccounts     VendorBankAccount[]     @relation("VendorBankUpdatedBy")
  createdVendorContacts         VendorContact[]         @relation("VendorContactCreatedBy")
  updatedVendorContacts         VendorContact[]         @relation("VendorContactUpdatedBy")

  createdIndents   Indent[] @relation("IndentCreatedBy")
  updatedIndents   Indent[] @relation("IndentUpdatedBy")
  submittedIndents Indent[] @relation("IndentSubmittedBy")
  decidedIndents   Indent[] @relation("IndentDecidedBy")
  cancelledIndents Indent[] @relation("IndentCancelledBy")

  createdEnquiries   Enquiry[] @relation("EnquiryCreatedBy")
  updatedEnquiries   Enquiry[] @relation("EnquiryUpdatedBy")
  sentEnquiries      Enquiry[] @relation("EnquirySentBy")
  closedEnquiries    Enquiry[] @relation("EnquiryClosedBy")
  cancelledEnquiries Enquiry[] @relation("EnquiryCancelledBy")

  createdQuotations   Quotation[] @relation("QuotationCreatedBy")
  updatedQuotations   Quotation[] @relation("QuotationUpdatedBy")
  submittedQuotations Quotation[] @relation("QuotationSubmittedBy")
  cancelledQuotations Quotation[] @relation("QuotationCancelledBy")

  createdComparisons   Comparison[] @relation("ComparisonCreatedBy")
  updatedComparisons   Comparison[] @relation("ComparisonUpdatedBy")
  finalisedComparisons Comparison[] @relation("ComparisonFinalisedBy")
  cancelledComparisons Comparison[] @relation("ComparisonCancelledBy")

  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

enum RoleScopeType {
  GLOBAL
  COMPANY
  PROJECT
  SITE
}

/// A role granted to a user at one scope. GLOBAL rows carry no target; COMPANY / PROJECT / SITE rows
/// carry exactly the matching target id (enforced by a CHECK constraint added in the migration).
model UserRole {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  roleId      String        @db.Uuid
  scopeType   RoleScopeType @default(GLOBAL)
  companyId   String?       @db.Uuid
  projectId   String?       @db.Uuid
  siteId      String?       @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  createdById String?       @db.Uuid

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  createdBy User?    @relation("UserRoleCreatedBy", fields: [createdById], references: [id])

  /// The migration creates this as UNIQUE NULLS NOT DISTINCT so GLOBAL duplicates are rejected too.
  @@unique([userId, roleId, scopeType, companyId, projectId, siteId], map: "user_roles_assignment_key")
  @@index([userId])
  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@map("user_roles")
}

model RolePermission {
  roleId         String @db.Uuid
  permissionCode String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  currentCompanyId String? @db.Uuid
  currentProjectId String? @db.Uuid

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentCompany Company? @relation("SessionCurrentCompany", fields: [currentCompanyId], references: [id], onDelete: SetNull)
  currentProject Project? @relation("SessionCurrentProject", fields: [currentProjectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  REACTIVATE
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  occurredAt  DateTime    @default(now()) @db.Timestamptz(3)
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String      @db.Uuid
  companyId   String?     @db.Uuid
  before      Json?
  after       Json?
  requestId   String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([actorUserId])
  @@map("audit_events")
}

enum CompanyEntityType {
  COMPANY
  SPV
  JV
}

enum GstRegistrationType {
  REGULAR
  COMPOSITION
  SEZ_UNIT
  CASUAL
  ISD
}

model State {
  id       String  @id @default(uuid()) @db.Uuid
  gstCode  String  @unique @db.Char(2)
  name     String
  isActive Boolean @default(true)

  companies              Company[]
  gstRegistrations       CompanyGstRegistration[]
  projects               Project[]
  sites                  Site[]
  vendors                Vendor[]
  vendorGstRegistrations VendorGstRegistration[]

  @@map("states")
}

model Company {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique
  legalName    String
  entityType   CompanyEntityType
  pan          String?
  tan          String?
  cin          String?
  llpin        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  stateId      String?           @db.Uuid
  pinCode      String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  createdById  String            @db.Uuid
  updatedById  String            @db.Uuid

  state            State?                   @relation(fields: [stateId], references: [id])
  createdBy        User                     @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  updatedBy        User                     @relation("CompanyUpdatedBy", fields: [updatedById], references: [id])
  gstRegistrations CompanyGstRegistration[]
  projects         Project[]
  userRoles        UserRole[]
  sessionContexts  Session[]                @relation("SessionCurrentCompany")

  documentSeries DocumentSeries[]
  indents        Indent[]
  enquiries      Enquiry[]
  quotations     Quotation[]
  comparisons    Comparison[]

  @@map("companies")
}

model CompanyGstRegistration {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @db.Uuid
  stateId          String              @db.Uuid
  gstin            String              @unique
  registrationType GstRegistrationType
  effectiveFrom    DateTime?           @db.Date
  addressLine1     String
  addressLine2     String?
  city             String
  pinCode          String
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  createdById      String              @db.Uuid
  updatedById      String              @db.Uuid

  company         Company   @relation(fields: [companyId], references: [id])
  state           State     @relation(fields: [stateId], references: [id])
  createdBy       User      @relation("GstRegistrationCreatedBy", fields: [createdById], references: [id])
  updatedBy       User      @relation("GstRegistrationUpdatedBy", fields: [updatedById], references: [id])
  billingProjects Project[]

  @@index([companyId])
  @@map("company_gst_registrations")
}

model Project {
  id                       String   @id @default(uuid()) @db.Uuid
  companyId                String   @db.Uuid
  code                     String
  name                     String
  stateId                  String?  @db.Uuid
  billingGstRegistrationId String?  @db.Uuid
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)
  createdById              String   @db.Uuid
  updatedById              String   @db.Uuid

  company    Company                 @relation(fields: [companyId], references: [id])
  state      State?                  @relation(fields: [stateId], references: [id])
  billingGst CompanyGstRegistration? @relation(fields: [billingGstRegistrationId], references: [id])
  createdBy  User                    @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  updatedBy  User                    @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])
  sites      Site[]
  userRoles  UserRole[]

  documentSeries DocumentSeries[]
  indents        Indent[]
  enquiries      Enquiry[]
  quotations     Quotation[]
  comparisons    Comparison[]

  sessionContexts Session[] @relation("SessionCurrentProject")

  @@index([companyId])
  @@map("projects")
}

model Site {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  code          String
  name          String
  addressLine1  String?
  addressLine2  String?
  city          String?
  stateId       String?  @db.Uuid
  pinCode       String?
  contactPerson String?
  contactPhone  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  createdById   String   @db.Uuid
  updatedById   String   @db.Uuid

  project   Project    @relation(fields: [projectId], references: [id])
  state     State?     @relation(fields: [stateId], references: [id])
  createdBy User       @relation("SiteCreatedBy", fields: [createdById], references: [id])
  updatedBy User       @relation("SiteUpdatedBy", fields: [updatedById], references: [id])
  stores    Store[]
  userRoles UserRole[]

  indents     Indent[]
  enquiries   Enquiry[]
  quotations  Quotation[]
  comparisons Comparison[]

  @@index([projectId])
  @@map("sites")
}

model Store {
  id          String   @id @default(uuid()) @db.Uuid
  siteId      String   @db.Uuid
  code        String
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String   @db.Uuid
  updatedById String   @db.Uuid

  site      Site     @relation(fields: [siteId], references: [id])
  createdBy User     @relation("StoreCreatedBy", fields: [createdById], references: [id])
  updatedBy User     @relation("StoreUpdatedBy", fields: [updatedById], references: [id])
  indents   Indent[]

  @@index([siteId])
  @@map("stores")
}

enum ItemUse {
  STOCK_AND_ISSUE
  STOCK_ONLY
}

enum ItemStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Unit of measure. decimalPlaces (0-3) limits quantities entered in this unit (CHECK in migration).
model Unit {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique
  name          String
  decimalPlaces Int      @default(0) @db.SmallInt
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  createdById   String   @db.Uuid
  updatedById   String   @db.Uuid

  createdBy User   @relation("UnitCreatedBy", fields: [createdById], references: [id])
  updatedBy User   @relation("UnitUpdatedBy", fields: [updatedById], references: [id])
  items     Item[]

  @@map("units")
}

/// Shown to users as "Category (Group)". code IG-0001 = last saved number + 1 (no gaps, PD-041).
model ItemCategory {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String   @db.Uuid
  updatedById String   @db.Uuid

  createdBy User   @relation("ItemCategoryCreatedBy", fields: [createdById], references: [id])
  updatedBy User   @relation("ItemCategoryUpdatedBy", fields: [updatedById], references: [id])
  items     Item[]

  @@map("item_categories")
}

/// Shared by all companies. code ITM-000001 = last saved number + 1 (no gaps, PD-041); never changes.
model Item {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique
  description     String
  size            String?
  categoryId      String     @db.Uuid
  unitId          String     @db.Uuid
  itemUse         ItemUse    @default(STOCK_AND_ISSUE)
  hsnCode         String?
  gstRate         Decimal?   @db.Decimal(5, 2)
  remarks         String?
  status          ItemStatus @default(DRAFT)
  submittedAt     DateTime?  @db.Timestamptz(3)
  submittedById   String?    @db.Uuid
  decidedAt       DateTime?  @db.Timestamptz(3)
  decidedById     String?    @db.Uuid
  decisionRemarks String?
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  createdById     String     @db.Uuid
  updatedById     String     @db.Uuid

  category       ItemCategory    @relation(fields: [categoryId], references: [id])
  unit           Unit            @relation(fields: [unitId], references: [id])
  submittedBy    User?           @relation("ItemSubmittedBy", fields: [submittedById], references: [id])
  decidedBy      User?           @relation("ItemDecidedBy", fields: [decidedById], references: [id])
  createdBy      User            @relation("ItemCreatedBy", fields: [createdById], references: [id])
  updatedBy      User            @relation("ItemUpdatedBy", fields: [updatedById], references: [id])
  indentLines    IndentLine[]
  enquiryLines   EnquiryLine[]
  quotationLines QuotationLine[]

  @@index([categoryId])
  @@index([unitId])
  @@index([status])
  @@map("items")
}

enum VendorType {
  SUPPLIER
  SUBCONTRACTOR
  SERVICE_PROVIDER
  TRANSPORTER
}

enum MsmeCategory {
  MICRO
  SMALL
  MEDIUM
}

enum VendorStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Shared by all companies (PD-044). code VEN-0001 = last saved number + 1 (no gaps, PD-041); never changes.
/// PAN and Udyam number are unique when entered (partial indexes in the migration).
model Vendor {
  id               String        @id @default(uuid()) @db.Uuid
  code             String        @unique
  legalName        String
  tradeName        String?
  vendorType       VendorType
  pan              String?
  udyamNumber      String?
  msmeCategory     MsmeCategory?
  addressLine1     String?
  addressLine2     String?
  city             String?
  stateId          String?       @db.Uuid
  pinCode          String?
  paymentTermsDays Int?          @db.SmallInt
  creditLimit      Decimal?      @db.Decimal(14, 2)
  remarks          String?
  status           VendorStatus  @default(DRAFT)
  submittedAt      DateTime?     @db.Timestamptz(3)
  submittedById    String?       @db.Uuid
  decidedAt        DateTime?     @db.Timestamptz(3)
  decidedById      String?       @db.Uuid
  decisionRemarks  String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(3)
  createdById      String        @db.Uuid
  updatedById      String        @db.Uuid

  state            State?                  @relation(fields: [stateId], references: [id])
  submittedBy      User?                   @relation("VendorSubmittedBy", fields: [submittedById], references: [id])
  decidedBy        User?                   @relation("VendorDecidedBy", fields: [decidedById], references: [id])
  createdBy        User                    @relation("VendorCreatedBy", fields: [createdById], references: [id])
  updatedBy        User                    @relation("VendorUpdatedBy", fields: [updatedById], references: [id])
  gstRegistrations VendorGstRegistration[]
  bankAccounts     VendorBankAccount[]
  contacts         VendorContact[]
  enquiries        EnquiryVendor[]
  quotations       Quotation[]
  comparisonLines  ComparisonLine[]

  @@index([status])
  @@index([stateId])
  @@map("vendors")
}

/// Same fields and checks as a company's GST registration. A vendor with no rows is unregistered (OQ-35 a).
model VendorGstRegistration {
  id               String              @id @default(uuid()) @db.Uuid
  vendorId         String              @db.Uuid
  stateId          String              @db.Uuid
  gstin            String              @unique
  registrationType GstRegistrationType
  effectiveFrom    DateTime?           @db.Date
  addressLine1     String
  addressLine2     String?
  city             String
  pinCode          String
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  createdById      String              @db.Uuid
  updatedById      String              @db.Uuid

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  state     State  @relation(fields: [stateId], references: [id])
  createdBy User   @relation("VendorGstCreatedBy", fields: [createdById], references: [id])
  updatedBy User   @relation("VendorGstUpdatedBy", fields: [updatedById], references: [id])

  @@index([vendorId])
  @@map("vendor_gst_registrations")
}

/// At most one active primary account per vendor (partial unique index in the migration).
model VendorBankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  vendorId      String   @db.Uuid
  accountName   String
  accountNumber String
  ifsc          String
  bankName      String
  branchName    String?
  isPrimary     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  createdById   String   @db.Uuid
  updatedById   String   @db.Uuid

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  createdBy User   @relation("VendorBankCreatedBy", fields: [createdById], references: [id])
  updatedBy User   @relation("VendorBankUpdatedBy", fields: [updatedById], references: [id])

  @@unique([vendorId, ifsc, accountNumber])
  @@index([vendorId])
  @@map("vendor_bank_accounts")
}

/// At most one active primary contact per vendor (partial unique index in the migration).
model VendorContact {
  id          String   @id @default(uuid()) @db.Uuid
  vendorId    String   @db.Uuid
  name        String
  designation String?
  phone       String?
  email       String?
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  createdById String   @db.Uuid
  updatedById String   @db.Uuid

  vendor    Vendor @relation(fields: [vendorId], references: [id])
  createdBy User   @relation("VendorContactCreatedBy", fields: [createdById], references: [id])
  updatedBy User   @relation("VendorContactUpdatedBy", fields: [updatedById], references: [id])

  @@index([vendorId])
  @@map("vendor_contacts")
}

enum DocumentType {
  INDENT
  ENQUIRY
  QUOTATION
  COMPARISON
}

/// Last number used per company / document type / project / financial year (PD-003). The next number
/// is taken inside the saving transaction with this row locked (SELECT ... FOR UPDATE), so no gaps.
/// projectId is null for company-level series; the migration makes the key UNIQUE NULLS NOT DISTINCT.
model DocumentSeries {
  id           String       @id @default(uuid()) @db.Uuid
  companyId    String       @db.Uuid
  documentType DocumentType
  projectId    String?      @db.Uuid
  fiscalYear   String
  lastNumber   Int          @default(0)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  company Company  @relation(fields: [companyId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])

  @@unique([companyId, documentType, projectId, fiscalYear], map: "document_series_key")
  @@map("document_series")
}

enum IndentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
}

/// Material indent (PD-046). number IND/<project>/<FY>/0001 is given on Submit; null while Draft.
/// companyId is copied from the project. createdBy = "Posted by"; requestedBy is text until the HR master (OQ-42).
model Indent {
  id              String       @id @default(uuid()) @db.Uuid
  number          String?      @unique
  fiscalYear      String?
  companyId       String       @db.Uuid
  projectId       String       @db.Uuid
  siteId          String       @db.Uuid
  storeId         String?      @db.Uuid
  indentDate      DateTime     @db.Date
  requiredByDate  DateTime?    @db.Date
  requestedBy     String
  remarks         String?
  status          IndentStatus @default(DRAFT)
  submittedAt     DateTime?    @db.Timestamptz(3)
  submittedById   String?      @db.Uuid
  decidedAt       DateTime?    @db.Timestamptz(3)
  decidedById     String?      @db.Uuid
  decisionRemarks String?
  cancelledAt     DateTime?    @db.Timestamptz(3)
  cancelledById   String?      @db.Uuid
  cancelRemarks   String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  createdById     String       @db.Uuid
  updatedById     String       @db.Uuid

  company     Company      @relation(fields: [companyId], references: [id])
  project     Project      @relation(fields: [projectId], references: [id])
  site        Site         @relation(fields: [siteId], references: [id])
  store       Store?       @relation(fields: [storeId], references: [id])
  submittedBy User?        @relation("IndentSubmittedBy", fields: [submittedById], references: [id])
  decidedBy   User?        @relation("IndentDecidedBy", fields: [decidedById], references: [id])
  cancelledBy User?        @relation("IndentCancelledBy", fields: [cancelledById], references: [id])
  createdBy   User         @relation("IndentCreatedBy", fields: [createdById], references: [id])
  updatedBy   User         @relation("IndentUpdatedBy", fields: [updatedById], references: [id])
  lines       IndentLine[]

  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([status])
  @@index([indentDate])
  @@map("indents")
}

/// One item per indent. requiredQty > 0; approvedQty 0..requiredQty, set at approval (CHECKs in the migration).
model IndentLine {
  id          String   @id @default(uuid()) @db.Uuid
  indentId    String   @db.Uuid
  lineNo      Int      @db.SmallInt
  itemId      String   @db.Uuid
  requiredQty Decimal  @db.Decimal(18, 3)
  approvedQty Decimal? @db.Decimal(18, 3)
  purpose     String?
  remarks     String?

  indent       Indent        @relation(fields: [indentId], references: [id])
  item         Item          @relation(fields: [itemId], references: [id])
  enquiryLines EnquiryLine[]

  @@unique([indentId, lineNo])
  @@unique([indentId, itemId])
  @@index([itemId])
  @@map("indent_lines")
}

enum EnquiryStatus {
  DRAFT
  SENT
  CLOSED
  CANCELLED
}

/// Purchase enquiry (PD-047). number ENQ/<project>/<FY>/0001 is given on Send; null while Draft.
/// siteId is the delivery location; all lines come from Approved indents of that site (OQ-51).
model Enquiry {
  id            String        @id @default(uuid()) @db.Uuid
  number        String?       @unique
  fiscalYear    String?
  companyId     String        @db.Uuid
  projectId     String        @db.Uuid
  siteId        String        @db.Uuid
  enquiryDate   DateTime      @db.Date
  quoteDueDate  DateTime      @db.Date
  terms         String?
  remarks       String?
  status        EnquiryStatus @default(DRAFT)
  sentAt        DateTime?     @db.Timestamptz(3)
  sentById      String?       @db.Uuid
  closedAt      DateTime?     @db.Timestamptz(3)
  closedById    String?       @db.Uuid
  cancelledAt   DateTime?     @db.Timestamptz(3)
  cancelledById String?       @db.Uuid
  cancelRemarks String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  createdById   String        @db.Uuid
  updatedById   String        @db.Uuid

  company     Company         @relation(fields: [companyId], references: [id])
  project     Project         @relation(fields: [projectId], references: [id])
  site        Site            @relation(fields: [siteId], references: [id])
  sentBy      User?           @relation("EnquirySentBy", fields: [sentById], references: [id])
  closedBy    User?           @relation("EnquiryClosedBy", fields: [closedById], references: [id])
  cancelledBy User?           @relation("EnquiryCancelledBy", fields: [cancelledById], references: [id])
  createdBy   User            @relation("EnquiryCreatedBy", fields: [createdById], references: [id])
  updatedBy   User            @relation("EnquiryUpdatedBy", fields: [updatedById], references: [id])
  lines       EnquiryLine[]
  vendors     EnquiryVendor[]
  quotations  Quotation[]
  comparisons Comparison[]

  @@index([companyId])
  @@index([projectId])
  @@index([siteId])
  @@index([status])
  @@index([enquiryDate])
  @@map("enquiries")
}

/// One row per indent line per enquiry; the same indent line may be in other enquiries (OQ-46).
/// itemId is copied from the indent line. quantity > 0 (CHECK); <= approved qty checked by the API (OQ-47).
model EnquiryLine {
  id           String  @id @default(uuid()) @db.Uuid
  enquiryId    String  @db.Uuid
  lineNo       Int     @db.SmallInt
  indentLineId String  @db.Uuid
  itemId       String  @db.Uuid
  quantity     Decimal @db.Decimal(18, 3)
  remarks      String?

  enquiry         Enquiry          @relation(fields: [enquiryId], references: [id])
  indentLine      IndentLine       @relation(fields: [indentLineId], references: [id])
  item            Item             @relation(fields: [itemId], references: [id])
  quotationLines  QuotationLine[]
  comparisonLines ComparisonLine[]

  @@unique([enquiryId, lineNo])
  @@unique([enquiryId, indentLineId])
  @@index([indentLineId])
  @@index([itemId])
  @@map("enquiry_lines")
}

/// Vendors the enquiry is sent to (approved, active vendors; checked by the API).
model EnquiryVendor {
  id        String   @id @default(uuid()) @db.Uuid
  enquiryId String   @db.Uuid
  vendorId  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id])
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@unique([enquiryId, vendorId])
  @@index([vendorId])
  @@map("enquiry_vendors")
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  SUPERSEDED
  CANCELLED
}

enum QuotationChargeType {
  FREIGHT
  LOADING_UNLOADING
  OTHER
}

/// Vendor quotation against a Sent enquiry (PD-049). number QTN/<project>/<FY>/0001 is given on the first
/// Submit; revisions keep the number with revisionNo 1, 2... (OQ-54). Project and site are copied from the
/// enquiry. Totals are computed by the API (PD-006). One Submitted and one Draft per enquiry + vendor
/// (partial unique indexes in the migration).
model Quotation {
  id               String          @id @default(uuid()) @db.Uuid
  number           String?
  revisionNo       Int             @default(0) @db.SmallInt
  revisedFromId    String?         @db.Uuid
  fiscalYear       String?
  companyId        String          @db.Uuid
  projectId        String          @db.Uuid
  siteId           String          @db.Uuid
  enquiryId        String          @db.Uuid
  vendorId         String          @db.Uuid
  vendorQuoteRef   String?
  quoteDate        DateTime        @db.Date
  validUntil       DateTime?       @db.Date
  deliveryDays     Int?            @db.SmallInt
  paymentTermsDays Int?            @db.SmallInt
  remarks          String?
  subtotal         Decimal         @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal         @default(0) @db.Decimal(18, 2)
  chargesTotal     Decimal         @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal         @default(0) @db.Decimal(18, 2)
  status           QuotationStatus @default(DRAFT)
  submittedAt      DateTime?       @db.Timestamptz(3)
  submittedById    String?         @db.Uuid
  supersededAt     DateTime?       @db.Timestamptz(3)
  cancelledAt      DateTime?       @db.Timestamptz(3)
  cancelledById    String?         @db.Uuid
  cancelRemarks    String?
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  createdById      String          @db.Uuid
  updatedById      String          @db.Uuid

  company     Company               @relation(fields: [companyId], references: [id])
  project     Project               @relation(fields: [projectId], references: [id])
  site        Site                  @relation(fields: [siteId], references: [id])
  enquiry     Enquiry               @relation(fields: [enquiryId], references: [id])
  vendor      Vendor                @relation(fields: [vendorId], references: [id])
  revisedFrom Quotation?            @relation("QuotationRevision", fields: [revisedFromId], references: [id])
  revisions   Quotation[]           @relation("QuotationRevision")
  submittedBy User?                 @relation("QuotationSubmittedBy", fields: [submittedById], references: [id])
  cancelledBy User?                 @relation("QuotationCancelledBy", fields: [cancelledById], references: [id])
  createdBy   User                  @relation("QuotationCreatedBy", fields: [createdById], references: [id])
  updatedBy   User                  @relation("QuotationUpdatedBy", fields: [updatedById], references: [id])
  lines       QuotationLine[]
  charges     QuotationCharge[]
  comparisons ComparisonQuotation[]

  @@unique([number, revisionNo], map: "quotations_number_revision_key")
  @@index([companyId])
  @@index([projectId])
  @@index([enquiryId])
  @@index([vendorId])
  @@index([status])
  @@map("quotations")
}

/// One row per enquiry line; quantity copied from the enquiry. A quoted line carries rate, discount, GST %
/// and the computed amounts; an unquoted line carries none of them (CHECK in the migration).
model QuotationLine {
  id              String   @id @default(uuid()) @db.Uuid
  quotationId     String   @db.Uuid
  lineNo          Int      @db.SmallInt
  enquiryLineId   String   @db.Uuid
  itemId          String   @db.Uuid
  quantity        Decimal  @db.Decimal(18, 3)
  isQuoted        Boolean  @default(false)
  rate            Decimal? @db.Decimal(18, 4)
  discountPercent Decimal? @db.Decimal(5, 2)
  gstRate         Decimal? @db.Decimal(5, 2)
  taxableAmount   Decimal? @db.Decimal(18, 2)
  taxAmount       Decimal? @db.Decimal(18, 2)
  lineTotal       Decimal? @db.Decimal(18, 2)
  makeBrand       String?
  remarks         String?

  quotation       Quotation        @relation(fields: [quotationId], references: [id])
  enquiryLine     EnquiryLine      @relation(fields: [enquiryLineId], references: [id])
  item            Item             @relation(fields: [itemId], references: [id])
  comparisonLines ComparisonLine[]

  @@unique([quotationId, lineNo])
  @@unique([quotationId, enquiryLineId])
  @@index([enquiryLineId])
  @@index([itemId])
  @@map("quotation_lines")
}

/// Freight, loading/unloading and one other charge per quotation, each with its own GST % (OQ-56).
model QuotationCharge {
  id          String              @id @default(uuid()) @db.Uuid
  quotationId String              @db.Uuid
  chargeType  QuotationChargeType
  description String?
  amount      Decimal             @db.Decimal(18, 2)
  gstRate     Decimal             @db.Decimal(5, 2)
  taxAmount   Decimal             @db.Decimal(18, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@unique([quotationId, chargeType])
  @@map("quotation_charges")
}

enum ComparisonStatus {
  DRAFT
  FINALISED
  CANCELLED
}

/// Comparative statement (PD-050). number CMP/<project>/<FY>/0001 is given on Finalise; null while Draft.
/// One open (Draft or Finalised) comparison per enquiry (partial unique index in the migration).
/// Finalise records the compared quotations and closes the enquiry (OQ-65).
model Comparison {
  id             String           @id @default(uuid()) @db.Uuid
  number         String?          @unique
  fiscalYear     String?
  companyId      String           @db.Uuid
  projectId      String           @db.Uuid
  siteId         String           @db.Uuid
  enquiryId      String           @db.Uuid
  comparisonDate DateTime         @db.Date
  remarks        String?
  status         ComparisonStatus @default(DRAFT)
  finalisedAt    DateTime?        @db.Timestamptz(3)
  finalisedById  String?          @db.Uuid
  cancelledAt    DateTime?        @db.Timestamptz(3)
  cancelledById  String?          @db.Uuid
  cancelRemarks  String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)
  createdById    String           @db.Uuid
  updatedById    String           @db.Uuid

  company     Company               @relation(fields: [companyId], references: [id])
  project     Project               @relation(fields: [projectId], references: [id])
  site        Site                  @relation(fields: [siteId], references: [id])
  enquiry     Enquiry               @relation(fields: [enquiryId], references: [id])
  finalisedBy User?                 @relation("ComparisonFinalisedBy", fields: [finalisedById], references: [id])
  cancelledBy User?                 @relation("ComparisonCancelledBy", fields: [cancelledById], references: [id])
  createdBy   User                  @relation("ComparisonCreatedBy", fields: [createdById], references: [id])
  updatedBy   User                  @relation("ComparisonUpdatedBy", fields: [updatedById], references: [id])
  lines       ComparisonLine[]
  quotations  ComparisonQuotation[]

  @@index([companyId])
  @@index([projectId])
  @@index([enquiryId])
  @@index([status])
  @@map("comparisons")
}

/// One row per enquiry line. Draft keeps only the chosen vendor and reason; Finalise fills quotationLineId,
/// netRate and rank together (CHECKs in the migration). Reason required when rank > 1 (OQ-63).
model ComparisonLine {
  id               String   @id @default(uuid()) @db.Uuid
  comparisonId     String   @db.Uuid
  enquiryLineId    String   @db.Uuid
  selectedVendorId String?  @db.Uuid
  reason           String?
  quotationLineId  String?  @db.Uuid
  netRate          Decimal? @db.Decimal(18, 4)
  rank             Int?     @db.SmallInt

  comparison     Comparison     @relation(fields: [comparisonId], references: [id])
  enquiryLine    EnquiryLine    @relation(fields: [enquiryLineId], references: [id])
  selectedVendor Vendor?        @relation(fields: [selectedVendorId], references: [id])
  quotationLine  QuotationLine? @relation(fields: [quotationLineId], references: [id])

  @@unique([comparisonId, enquiryLineId])
  @@index([enquiryLineId])
  @@index([selectedVendorId])
  @@index([quotationLineId])
  @@map("comparison_lines")
}

/// The Submitted quotations a Finalised comparison was based on (written at Finalise).
model ComparisonQuotation {
  comparisonId String @db.Uuid
  quotationId  String @db.Uuid

  comparison Comparison @relation(fields: [comparisonId], references: [id])
  quotation  Quotation  @relation(fields: [quotationId], references: [id])

  @@id([comparisonId, quotationId])
  @@index([quotationId])
  @@map("comparison_quotations")
}
