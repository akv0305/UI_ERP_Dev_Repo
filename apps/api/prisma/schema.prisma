generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique
  email              String?   @unique
  displayName        String
  passwordHash       String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(3)
  lastLoginAt        DateTime? @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid

  createdBy    User?        @relation("UserCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?        @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  createdUsers User[]       @relation("UserCreatedBy")
  updatedUsers User[]       @relation("UserUpdatedBy")
  roles        UserRole[]
  sessions     Session[]
  auditEvents  AuditEvent[]

  createdCompanies        Company[]                @relation("CompanyCreatedBy")
  updatedCompanies        Company[]                @relation("CompanyUpdatedBy")
  createdGstRegistrations CompanyGstRegistration[] @relation("GstRegistrationCreatedBy")
  updatedGstRegistrations CompanyGstRegistration[] @relation("GstRegistrationUpdatedBy")

  @@map("users")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId         String @db.Uuid
  permissionCode String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique
  userId     String    @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum AuditAction {
  CREATE
  UPDATE
  DEACTIVATE
  REACTIVATE
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  occurredAt  DateTime    @default(now()) @db.Timestamptz(3)
  actorUserId String?     @db.Uuid
  action      AuditAction
  entityType  String
  entityId    String      @db.Uuid
  companyId   String?     @db.Uuid
  before      Json?
  after       Json?
  requestId   String?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([occurredAt])
  @@index([actorUserId])
  @@map("audit_events")
}

enum CompanyEntityType {
  COMPANY
  SPV
  JV
}

enum GstRegistrationType {
  REGULAR
  COMPOSITION
  SEZ_UNIT
  CASUAL
  ISD
}

model State {
  id       String  @id @default(uuid()) @db.Uuid
  gstCode  String  @unique @db.Char(2)
  name     String
  isActive Boolean @default(true)

  companies        Company[]
  gstRegistrations CompanyGstRegistration[]

  @@map("states")
}

model Company {
  id           String            @id @default(uuid()) @db.Uuid
  code         String            @unique
  legalName    String
  entityType   CompanyEntityType
  pan          String?
  tan          String?
  cin          String?
  llpin        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  stateId      String?           @db.Uuid
  pinCode      String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  createdById  String            @db.Uuid
  updatedById  String            @db.Uuid

  state            State?                   @relation(fields: [stateId], references: [id])
  createdBy        User                     @relation("CompanyCreatedBy", fields: [createdById], references: [id])
  updatedBy        User                     @relation("CompanyUpdatedBy", fields: [updatedById], references: [id])
  gstRegistrations CompanyGstRegistration[]

  @@map("companies")
}

model CompanyGstRegistration {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @db.Uuid
  stateId          String              @db.Uuid
  gstin            String              @unique
  registrationType GstRegistrationType
  effectiveFrom    DateTime?           @db.Date
  addressLine1     String
  addressLine2     String?
  city             String
  pinCode          String
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  createdById      String              @db.Uuid
  updatedById      String              @db.Uuid

  company   Company @relation(fields: [companyId], references: [id])
  state     State   @relation(fields: [stateId], references: [id])
  createdBy User    @relation("GstRegistrationCreatedBy", fields: [createdById], references: [id])
  updatedBy User    @relation("GstRegistrationUpdatedBy", fields: [updatedById], references: [id])

  @@index([companyId])
  @@map("company_gst_registrations")
}
